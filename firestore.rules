rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Usuários: lê/escreve o próprio doc; admin lê todos
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    // Chaves de convite: leitura para validar no cadastro; só admin cria/gerencia;
    // consumo (usedCount +1) liberado para qualquer autenticado, dentro do limite
    match /invite_keys/{code} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']) &&
        request.resource.data.usedCount == resource.data.usedCount + 1 &&
        resource.data.usedCount < resource.data.maxUses &&
        resource.data.active == true
      );
    }

    // Idosos: lê/escreve quem pertence à família
    match /elderly/{elderlyId} {
      allow read: if request.auth != null && (
        request.auth.uid == elderlyId ||
        request.auth.uid == resource.data.familyId
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        request.auth.uid == elderlyId ||
        request.auth.uid == resource.data.familyId
      );
    }

    // Medicações: família e o próprio idoso
    match /medications/{medId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.elderlyId ||
        request.auth.uid == resource.data.familyId
      );
    }

    // Logs de medicação
    match /medication_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // Alertas
    match /alerts/{alertId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.elderlyId ||
        request.auth.uid == resource.data.familyId
      );
    }

    // Perfil QR: leitura pública (escaneamento por médicos/socorristas)
    match /qr_profiles/{profileId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Famílias
    match /families/{familyId} {
      allow read, write: if request.auth != null;
    }
  }
}
